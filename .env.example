# Server
PORT=3002
NODE_ENV=development

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Database
# PostgreSQL (recommended)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
# Your existing database
DB_NAME=tienda-app
DB_USER=postgres
DB_PASSWORD=123456
# IMPORTANT: isolates tables to avoid collisions with existing apps (public schema)
DB_SCHEMA=tienda_api

# SQLite (optional local dev)
# DB_DIALECT=sqlite
# DB_STORAGE=./dev.sqlite

# Free plan limits (optional)
FREE_MAX_PRODUCTS=200
